{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ielts-fullstack",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"kv_namespaces": [
		{
			"binding": "IELTS_WRITING_KV",
			"id": "cc61a444e44740b6b1d9ff59a1f3f75b"
		}
	],
	"r2_buckets": [
		{
			"binding": "IELTS_WRITING_BUCKET",
			"bucket_name": "my-bucket"
		}
	],
	"d1_databases": [
		{
			"binding": "IELTS_WRITING_DB",
			"database_name": "main-database",
			"database_id": "08b1ad6e-a246-4320-a434-ff2f3f6d7e05",
			"migrations_dir": "drizzle"
		}
	],
	"ai": {
		"binding": "IELTS_WRITING_AI",
		"remote": true
	},
	"images": {
		"binding": "IELTS_WRITING_IMAGES"
	},
	"cache": {
		"enabled": true
	}
}
