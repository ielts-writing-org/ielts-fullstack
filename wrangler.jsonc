{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ielts-fullstack",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "IELTS_WRITING_DB",
			"database_name": "main-database",
			"database_id": "08b1ad6e-a246-4320-a434-ff2f3f6d7e05",
			"migrations_dir": "drizzle",
			"migrations_pattern": "drizzle/*/migration.sql"
		}
	],
	"r2_buckets": [
		{
			"binding": "IELTS_WRITING_BUCKET",
			"bucket_name": "ielts-writing-bucket"
		}
	],
	"ai": { "binding": "IELTS_WRITING_AI", "remote": true },
	"images": { "binding": "IELTS_WRITING_IMAGES" },
	"ratelimits": [
		{
			"name": "CHAT_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 3, "period": 60 }
		},
		{
			"name": "EVALUATE_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 1, "period": 60 }
		}
	],
	"routes": [
		{
			"pattern": "ielts-writing.ptus04.id.vn",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"vars": {
		"R2_ENDPOINT": "https://r2.ielts-writing.ptus04.id.vn"
	},
	"workers_dev": true,
	"preview_urls": true,
	"cache": { "enabled": false },
	"observability": {
		"issues": { "enabled": true },
		"logs": { "enabled": true },
		"traces": { "enabled": true }
	}
}
