{
	"useTabs": true,
	"trailingComma": "none",
	"printWidth": 100,
	"overrides": [
		{
			"files": ["client/**/*.svelte"],
			"options": {
				"parser": "svelte",
				"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
				"tailwindStylesheet": "client/src/routes/layout.css",
				"bracketSameLine": true,
				"svelteBracketNewLine": false
			}
		}
	]
}
