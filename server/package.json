{
	"name": "ielts-server",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"exports": {
		"./*": "./src/*.ts"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"dev": "wrangler dev --tunnel-name=ielts-writing",
		"deploy": "wrangler deploy --minify",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint . --fix",
		"lint:format": "prettier --write .",
		"test": "npm run test:unit -- --run",
		"test:unit": "vitest"
	},
	"dependencies": {
		"@better-auth/infra": "^0.4.11",
		"@inferdi/hono": "^6.1.0",
		"@inferdi/inferdi": "^6.1.0",
		"@scalar/hono-api-reference": "^0.12.6",
		"better-auth": "^1.7.6",
		"hono": "^4.13.9",
		"hono-openapi": "^1.3.3",
		"sanitize-html": "^2.17.7",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.2.8",
		"@eslint/js": "^10.0.1",
		"@hono/eslint-config": "^2.1.1",
		"@types/node": "^26.6.3",
		"@types/sanitize-html": "^2.16.1",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"prettier": "^3.9.9",
		"typescript-eslint": "^8.70.1",
		"vitest": "^4.1.11",
		"wrangler": "^4.141.0"
	}
}
