{
	"name": "ielts-fullstack",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"gen": "wrangler types",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:unit": "vitest",
		"test:e2e": "playwright install && playwright test",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev --port 5173",
		"preview:e2e": "wrangler dev -c wrangler.e2e.jsonc --port 5173 --persist-to .wrangler/state/e2e",
		"auth:schema": "auth generate --config src/lib/server/auth/cli.ts --output src/lib/server/db/auth.schema.ts --yes",
		"db:studio": "drizzle-kit studio",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:remote": "wranger d1 migrations apply main-database --remote --yes"
	},
	"dependencies": {
		"@better-auth/infra": "^0.4.28",
		"@lucide/svelte": "^1.72.0",
		"@streamparser/json": "^0.0.26",
		"better-auth": "^1.7.20",
		"drizzle-orm": "^0.45.4",
		"eventsource-parser": "^4.1.3",
		"harper.js": "^3.0.0",
		"marked": "^18.2.0",
		"nodemailer": "^10.5.0",
		"quill": "^2.0.3",
		"sanitize-html": "^2.18.1",
		"uuidv7": "^1.2.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/sanitize-html": "^2.16.2",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"auth": "^1.7.20",
		"better-sqlite3": "^13.0.3",
		"daisyui": "^5.7.50",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-svelte": "^3.24.1",
		"eslint-plugin-tailwind-canonical-classes": "^1.6.1",
		"globals": "^17.14.0",
		"localflare": "^0.5.0",
		"playwright": "^1.65.0",
		"prettier": "^3.10.0",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sv": "^1.3.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"type-fest": "^5.10.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.160.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
