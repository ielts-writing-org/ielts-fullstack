{
	"name": "ielts-fullstack",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/schema/auth.schema.ts --yes"
	},
	"dependencies": {
		"@better-auth/infra": "^0.4.14",
		"@lucide/svelte": "^1.51.0",
		"@streamparser/json": "^0.0.26",
		"better-auth": "^1.7.7",
		"colorjs.io": "^0.7.1",
		"drizzle-orm": "^0.45.3",
		"eventsource-parser": "^4.1.1",
		"harper.js": "^2.10.0",
		"marked": "^18.0.14",
		"quill": "^2.0.3",
		"sanitize-html": "^2.18.0",
		"virtual-dom": "^2.1.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.4",
		"@types/sanitize-html": "^2.16.2",
		"@types/virtual-dom": "^2.1.4",
		"@vitest/browser-playwright": "^5.0.3",
		"@vitest/coverage-v8": "^5.0.3",
		"auth": "^1.7.7",
		"better-sqlite3": "^13.0.3",
		"daisyui": "^5.7.47",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-svelte": "^3.19.0",
		"eslint-plugin-tailwind-canonical-classes": "^1.4.1",
		"globals": "^17.13.0",
		"localflare": "^0.5.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sv": "^1.0.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.0",
		"type-fest": "^5.10.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.147.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
