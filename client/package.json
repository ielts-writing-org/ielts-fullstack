{
	"name": "ielts-client",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint . --fix",
		"lint:format": "prettier --write .",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"test:unit": "vitest"
	},
	"dependencies": {
		"@lucide/svelte": "^1.48.0",
		"@streamparser/json": "^0.0.26",
		"better-auth": "^1.7.6",
		"colorjs.io": "^0.7.1",
		"eventsource-parser": "^4.1.1",
		"harper.js": "^2.10.0",
		"hono": "^4.13.9",
		"ielts-server": "*",
		"marked": "^18.0.14",
		"virtual-dom": "^2.1.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.3",
		"@types/virtual-dom": "^2.1.4",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"daisyui": "^5.7.46",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"eslint-plugin-tailwind-canonical-classes": "^1.4.1",
		"globals": "^17.6.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"quill": "^2.0.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.1.0"
	}
}
