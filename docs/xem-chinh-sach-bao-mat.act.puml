@startuml Xem chính sách bảo mật ACT

skinparam DefaultFontName Segoe UI

|Tác nhân chính|
start
if (Người dùng đã có phiên đăng nhập?) then (Có)
	:Truy cập trang chính sách bảo mật\ntừ trang chủ;
else (Không)
	:Truy cập trang chính sách bảo mật\ntừ trang đăng nhập;
endif

|Hệ thống|
:Hiển thị chính sách bảo mật;
stop

@enduml
