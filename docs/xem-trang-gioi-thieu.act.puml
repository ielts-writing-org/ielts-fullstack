@startuml Xem trang giới thiệu nền tảng ACT

skinparam DefaultFontName Segoe UI

|Tác nhân chính|
start
:Truy cập hệ thống;

|Hệ thống|
if (Người dùng đã đăng nhập?) then (Có)
	:Hiển thị trang chủ\ncó thẻ giới thiệu nền tảng;
	stop
else (Không)
	:Chuyển hướng người dùng đến\ntrang đăng nhập đồng thời là trang\ngiới thiệu nền tảng;
	stop
endif

@enduml
