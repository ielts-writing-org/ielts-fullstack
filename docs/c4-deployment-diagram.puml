@startuml C4 Deployment Diagram

!include <C4/C4_Deployment>

skinparam DefaultFontName Segoe UI

LAYOUT_LEFT_RIGHT()

Deployment_Node(client, "Client Device", "Desktop or mobile device"){
	Deployment_Node(browser, "Web Browser", "Chrome, Firefox, Safari or Edge"){
		Container(spa, "Web Application", "SvelteKit 3 (browser runtime)", "Instance of the Web Application container.")
	}
}

Deployment_Node(cloudflare, "Cloudflare", "Global edge network (SaaS)"){
	Node(appDomain, "ielts-writing.ptus04.id.vn", "Workers Custom Domain")

	Deployment_Node(worker, "ielts-fullstack", "Cloudflare Workers isolate"){
		Container(app, "Application Server", "SvelteKit 3 on workerd", "Instance of the Application Server container: SSR, remote functions, SSE and Better Auth endpoints.")
		Container(assets, "Static Assets", "Workers Static Assets", "Instance of the SvelteKit build output served through the ASSETS binding.")
	}
	Deployment_Node(d1Node, "D1", "Managed serverless SQLite"){
		ContainerDb(db, "Application Database", "Cloudflare D1 (main-database)", "Instance of the Application Database container.")
	}
	Deployment_Node(r2Node, "R2", "Managed object storage"){
		ContainerDb(r2, "Task Image Store", "Cloudflare R2 (ielts-writing-bucket)", "Instance of the Task Image Store container.")
	}
	Node(r2Domain, "r2.ielts-writing.ptus04.id.vn", "R2 Public Custom Domain")
	Deployment_Node(aiNode, "Workers AI", "Remote GPU inference"){
		Container(ai, "AI Inference", "Workers AI (remote binding)", "Instance of the AI Inference container.")
	}
	Deployment_Node(imgNode, "Images", "Managed image transformation"){
		Container(images, "Image Processing", "Cloudflare Images binding", "Instance of the Image Processing container")
	}
	Deployment_Node(rlNode, "Rate Limiting", "Workers Rate Limiting API"){
		Container(rl, "Rate Limiter", "Rate Limiting binding", "Chat: 3 requests/minute; Evaluate: 1 request/minute")
	}
}

Deployment_Node(githubNode, "GitHub", "Third-party SaaS"){
	System_Ext(github, "GitHub OAuth", "Identity provider used for social sign-in (OAuth 2.0).")
}

Deployment_Node(mailNode, "TenTen Mail Infrastructure", "Third-party SMTP provider"){
	System_Ext(smtp, "TenTen SMTP Mail Server", "Delivers verification, password-reset and duplicate-signup notification emails.")
}

Rel(spa, appDomain, "Requests pages, remote functions and SSE streams", "HTTPS / SSE")
Rel(appDomain, app, "Routes requests to the deployed Worker", "Custom domain route")
Rel(app, spa, "Responds with SSR HTML and streamed data", "HTTPS / SSE")
Rel(assets, spa, "Delivers static assets", "HTTPS")

Rel(spa, r2Domain, "Fetches task images directly", "HTTPS")
Rel(r2Domain, r2, "Serves stored objects", "Public bucket domain")

Rel(app, db, "Reads and writes data", "SQL via Drizzle")
Rel(app, r2, "Stores, reads and deletes task images", "R2 binding")
Rel(app, images, "Compresses uploaded images", "Images binding")
Rel(app, ai, "Runs models and receives streamed output", "AI binding")
Rel(app, rl, "Checks request limits", "Rate Limiting binding")

Rel(app, github, "Delegates sign-in", "OAuth 2.0 / HTTPS")
Rel(app, smtp, "Sends email", "SMTP (port 587)")

@enduml
