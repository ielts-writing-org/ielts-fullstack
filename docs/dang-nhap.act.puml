@startuml Đăng nhập bằng GitHub ACT

skinparam DefaultFontName Segoe UI

|Tác nhân chính|
start
:Chọn “Continue with GitHub”;

|Hệ thống|
:Chuyển hướng người dùng đến\ntrang đăng nhập của GitHub;

|OAuth Provider|
if (Đã đăng nhập GitHub?) then (Có)
else (Không)
	:Hiển thị trang đăng nhập;

	|Tác nhân chính|
	:Nhập thông tin đăng nhập GitHub;

	|OAuth Provider|
	:Xác thực thông tin đăng nhập;
endif

if (Đã cấp quyền trước đó?) then (Có)
else (Không)
	:Hiển thị trang cấp quyền;

	|Tác nhân chính|
	if (Cấp quyền cho phép hệ thống\ntruy cập thông tin tài khoản GitHub?) then (Có)
    label 1
	else (Không)
		|OAuth Provider|
		:Chuyển hướng người dùng về hệ thống\nvới trạng thái từ chối cấp quyền;

		|Hệ thống|
		:Thông báo cấp quyền thất bại;
		stop
	endif
endif

|OAuth Provider|
:Chuyển hướng người dùng về hệ thống\nvới mã ủy quyền (code) và tham số state;

|Hệ thống|
if (Dữ liệu hợp lệ?) then (Có)
	:Lấy thông tin người dùng từ GitHub;
	if (Đã có tài khoản?) then (Có)
	else (Không)
		:Tạo liên kết tài khoản\nvà người dùng;
	endif
	if (Tài khoản bị cấm?) then (Có)
		:Thông báo tài khoản bị cấm;
		stop
	endif
	:Tạo phiên đăng nhập;
	:Chuyển hướng người dùng\nvề trang chủ;
	stop
else (Không)
	:Thông báo dữ liệu không hợp lệ;
	stop
endif

@enduml
