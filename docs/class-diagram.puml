@startuml Domain Class Diagram

skinparam DefaultFontName Segoe UI
skinparam classAttributeIconSize 0

' Operations are implemented as plain module functions (#lib/domain: task, task-image,
' evaluation, practice-session, chat-message, text-stats, ai-config, theme, save-state;
' #lib/server/data: tasks, practice-sessions, chat-messages, evaluations, ai-requests,
' ai-settings, users, profiles, admin-audit-logs) - the runtime uses modules, not classes.
' Associations express ownership and references; bookkeeping columns (ids, timestamps)
' are implementation detail and intentionally omitted.

class User {
	-name: string
	-email: string
	-emailVerified: boolean
	-image: string | null
	-role: string | null
	-banned: boolean
	-banReason: string | null
	-banExpires: Date | null
	+isAdmin(): boolean
	+isLocked(): boolean
}

class Profile {
	-bandTarget: number | null
	-theme: string
	+hasBandTarget(): boolean
	+setBandTarget(band): void
}

class Task {
	-category: TaskCategory
	-subcategory: TaskSubcategory | null
	-topic: string | null
	-difficulty: TaskDifficulty | null
	-published: boolean
	-prompt: string
	+isExample(): boolean
	+isImageRequired(): boolean
	+idealResponseWords(): number
	+acceptableResponseWords(): [number, number]
	+isPromptValid(): boolean
}

class PracticeSession {
	-name: string
	-type: PracticeType
	-response: string
	-timeUpAction: "stop" | null
	-startedAt: Date
	+stats(): DeterministicStats
	+wordCount(): number
	+isTimed(): boolean
	+remainingSeconds(nowMs): number
	+isWithinWordRange(): boolean
	+isNameValid(name): boolean
	+rename(name): void
}

class ChatMessage {
	-from: "assistant" | "user"
	-message: string
	+wordCount(): number
	+isWithinWordLimit(): boolean
	+isFromUser(): boolean
}

class Evaluation {
	-taskCategory: TaskCategory
	-criteria: Record<Criteria, EvaluationCriterion>
	-summary: string
	-estimatedBand: number
	+isTask1(): boolean
	+roundedBand(): number
	+combineWritingBands(band1, band2): number
}

class EvaluationCriterion {
	-band: number
	-why: string
	-nextBandGap: string | null
	+label(): string
}

class CriterionCheck {
	-title: string
	-status: CriterionCheckStatus
	-evidence: string
	+isMet(): boolean
	+statusLabel(): string
}

class CriterionStrength {
	-title: string
	-evidence: string
}

class CriterionWeakness {
	-title: string
	-evidence: string
	-advice: string
}

class TaskImage {
	-file: File
	+isValidSize(): boolean
	+isValidExtension(): boolean
	+isValidName(name): boolean
	+path(): string
	+allowedMimeTypes(): string[]
	+createName(): string
}

class DeterministicStats {
	-words: number
	-characters: number
	-sentences: number
	-paragraphs: number
}

class AiRequest {
	-kind: AiRequestKind
	-status: "pending" | "success" | "error"
	-model: string
	-startedAt: Date
	-durationMs: number | null
	-inputTokens: number | null
	-outputTokens: number | null
	-errorSummary: string | null
	+fail(summary): void
}

class AiSetting {
	-key: string
	-value: string
	+chatPrompt(taskCategory): string
	+evaluationPrompt(taskCategory): string
	+runtimeConfig(defaults): AiRuntimeConfig
}

class AdminAuditLog {
	-action: string
	-targetType: string
	+recent(limit): AdminAuditLog[]
}

enum TaskCategory {
	"1"
	"2"
}

enum TaskSubcategory {
	line-graph
	bar-chart
	pie-chart
	table
	mixed-charts
	process
	map
	letter
	opinion-essay
	discussion-essay
	advantages-disadvantages-essay
	problem-solution-essay
	two-part-question-essay
}

enum TaskDifficulty {
	beginner
	intermediate
	advanced
}

enum PracticeType {
	free
	timed
}

enum Criteria {
	taskAchievement
	taskResponse
	coherenceAndCohesion
	lexicalResource
	grammaticalRangeAndAccuracy
}

enum CriterionCheckStatus {
	met
	partially_met
	not_met
}

enum AiRequestKind {
	grading
	chat
}

class AiRuntimeConfig {
	-chatModel: AiModel
	-gradingModel: AiGradingModel
	-enableThinking: boolean
	-maxOutputTokens: number
	-seed: number
	-temperature: number
	-chatDailyLimit: number
	-gradingDailyLimit: number
}

User "1" -- "0..1" Profile : has >
User "1" -- "0..*" Task : owns >
User "1" -- "0..*" PracticeSession : practices >
Task "1" -- "0..*" PracticeSession : is used in >
Task "1" -- "0..1" TaskImage : has >
PracticeSession "1" -- "0..1" Evaluation : is graded by >
PracticeSession "1" -- "0..*" ChatMessage : contains >
PracticeSession ..> DeterministicStats : analyses >
User "1" -- "0..*" AiRequest : triggers >
PracticeSession "1" -- "0..*" AiRequest : serves >
User "1" -- "0..*" AdminAuditLog : acts in >
User "1" -- "0..*" AiSetting : configures >

Evaluation *-- "4" EvaluationCriterion : groups >
EvaluationCriterion *-- "1..*" CriterionCheck : checks >
EvaluationCriterion *-- "0..*" CriterionStrength : highlights >
EvaluationCriterion *-- "0..*" CriterionWeakness : flags >

Task --> TaskCategory
Task --> TaskSubcategory
Task --> TaskDifficulty
PracticeSession --> PracticeType
Evaluation --> TaskCategory
EvaluationCriterion ..> Criteria
CriterionCheck --> CriterionCheckStatus
AiRequest --> AiRequestKind
AiSetting --> AiRuntimeConfig

@enduml
